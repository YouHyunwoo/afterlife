{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "6c55b63c13c84de2b6e4d4a822f5a305",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "FoamCells (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -3287.000732421875,
            "y": 2287.00048828125,
            "width": 213.0,
            "height": 214.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "a4a08a077c014d06a19de7fbf2fa10fb"
        },
        {
            "m_Id": "d4396ead88a3444a85cbbfee8dcefcd8"
        },
        {
            "m_Id": "41ee6ba4d02d430e8e1dfa85a6ceb717"
        },
        {
            "m_Id": "5a2d4550eefa4966b391013f4af6c0ea"
        },
        {
            "m_Id": "22917b23c6894f57864bcfd47a2fd00d"
        },
        {
            "m_Id": "2d31f821b14f44e294c2e2f67b7217d7"
        },
        {
            "m_Id": "dfd346b7044f477b9142c6fecc47964c"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 1,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "FoamCells",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 moving = (WorldXZ + Drift * TimeSeconds) / max(FoamScale, 0.1);\r\nfloat2 p = moving * 3.2;\r\nfloat2 cell = floor(p);\r\nfloat2 local = frac(p);\r\nfloat nearest = 8.0;\r\nfloat second = 8.0;\r\n\r\n[unroll] for (int y = -1; y <= 1; y++)\r\n{\r\n    [unroll] for (int x = -1; x <= 1; x++)\r\n    {\r\n        float2 offset = float2(x, y);\r\n        float2 q = cell + offset + Seed;\r\n        float2 randomPoint = frac(sin(float2(\r\n            dot(q, float2(127.1, 311.7)),\r\n            dot(q, float2(269.5, 183.3))\r\n        )) * 43758.5453);\r\n\r\n        float2 delta = offset + 0.15 + 0.7 * randomPoint - local;\r\n        float distanceSquared = dot(delta, delta);\r\n\r\n        if (distanceSquared < nearest)\r\n        {\r\n            second = nearest;\r\n            nearest = distanceSquared;\r\n        }\r\n        else\r\n        {\r\n            second = min(second, distanceSquared);\r\n        }\r\n    }\r\n}\r\n\r\nMask = 1.0 - smoothstep(\r\n    Width, Width + 0.075,\r\n    sqrt(second) - sqrt(nearest)\r\n);"
}


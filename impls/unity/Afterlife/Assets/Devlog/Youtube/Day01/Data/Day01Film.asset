    Cues:
    - Start: 0.55
      Duration: 6.364
      Text: "\uB545\uC740 \uD0C0\uC77C\uB9C8\uB2E4 \uB04A\uAE30\uC9C0 \uC54A\uB3C4\uB85D,
        \uC9C0\uB3C4 \uC804\uCCB4\uC5D0 \uC774\uC5B4\uC9C0\uB294 \uAD74\uACE1\uC744
        \uC92C\uC2B5\uB2C8\uB2E4."
      Narration: {fileID: 8300000, guid: f7f959b66f898a949ad19f7b7314b006, type: 3}
    - Start: 7.114
      Duration: 4.068
      Text: "\uD480\uACFC \uBAA8\uB798, \uB3CC\uC758 \uACBD\uACC4\uC5D0\uB3C4 \uBCC0\uD654\uB97C
        \uB354\uD588\uC5B4\uC694."

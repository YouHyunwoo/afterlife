    Heading: "02 \xB7 \uBAA8\uB378\uACFC \uD53D\uC140"
    Cues:
    - Start: 0.55
      Duration: 4.658
      Text: "\uB3C4\uD615\uC744 \uC911\uC138\uD48D \uBAA8\uB378\uB85C \uBC14\uAFB8\uACE0,
        \uC0C9\uC744 \uC785\uD614\uC2B5\uB2C8\uB2E4."
      Narration: {fileID: 8300000, guid: 5d4dfd11feb9f884d80c473d19f75a47, type: 3}
    - Start: 5.408
      Duration: 5.516
      Text: "\uC5EC\uAE30\uC5D0 \uD53D\uC140 \uB290\uB08C\uC744 \uB354\uD574, \uC791\uC740
        \uB514\uC624\uB77C\uB9C8\uCC98\uB7FC \uBCF4\uC774\uAC8C \uD588\uC5B4\uC694."
      Narration: {fileID: 8300000, guid: 19e07d7f12afbf84faebb8d4802cdc7d, type: 3}

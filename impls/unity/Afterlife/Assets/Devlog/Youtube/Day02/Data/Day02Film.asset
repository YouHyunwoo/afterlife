    Cues:
    - Start: 0.55
      Duration: 5.008
      Text: "\uC774\uC81C \uC6D0\uD558\uB294 \uB098\uBB34\uC640 \uBC14\uC704\uB97C
        \uB204\uB974\uBA70 \uACE8\uB4DC\uB97C \uBAA8\uC544 \uBD05\uC2DC\uB2E4."
      Narration: {fileID: 8300000, guid: 15aa2e852940fa34a90b4867780a8979, type: 3}
    - Start: 5.758
      Duration: 6.718
      Text: "\uC9C1\uC811 \uCC44\uC9D1\uC73C\uB85C \uD544\uC694\uD55C \uB3C8\uC744
        \uB9C8\uB828\uD558\uACE0, \uB9C8\uC744\uC758 \uC131\uC7A5\uC744 \uC55E\uB2F9\uAE30\uB294
        \uD750\uB984\uC785\uB2C8\uB2E4."
      Narration: {fileID: 8300000, guid: c73cb78d5f2bc8549b315c074089256b, type: 3}
    ShowCredits: 0

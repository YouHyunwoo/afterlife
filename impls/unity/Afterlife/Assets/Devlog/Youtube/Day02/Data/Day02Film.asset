    - Start: 0.55
      Duration: 5.299
      Text: "\uCC98\uC74C\uC5D0\uB294 \uD074\uB9AD \uD55C \uBC88\uC5D0 \uD55C \uBC88\uC529
        \uCC44\uC9D1\uD558\uB3C4\uB85D \uB9CC\uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
      Narration: {fileID: 8300000, guid: af98acfc3a01a064fb7236674d8b3980, type: 3}
    - Start: 6.049
      Duration: 6.349
      Text: "\uADF8\uB7F0\uB370 \uC790\uC6D0\uC744 \uBAA8\uC744 \uB54C\uB9C8\uB2E4
        \uACC4\uC18D \uD074\uB9AD\uD558\uBA74 \uAE08\uBC29 \uD53C\uACE4\uD574\uC9C8
        \uAC83 \uAC19\uC558\uC2B5\uB2C8\uB2E4."
      Narration: {fileID: 8300000, guid: 32e423819870e7d4b9b1a5a08f5c3418, type: 3}
    ShowCredits: 0

    Heading: "\uCC44\uC9D1\uC744 \uD3B8\uD558\uAC8C, \uC131\uC7A5\uC740 \uD655\uC2E4\uD558\uAC8C"
    Cues:
    - Start: 0.75
      Duration: 7.847
      Text: "\uB0AE\uC5D0\uB294 \uC790\uC6D0\uC744 \uBAA8\uC544 \uB9C8\uC744\uC744
        \uD0A4\uC6B0\uACE0, \uBC24\uC5D0\uB294 \uBAB0\uB824\uC624\uB294 \uC801\uC744
        \uB9C9\uB294 \uAC8C\uC784\uC744 \uB9CC\uB4E4\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
      Narration: {fileID: 8300000, guid: 0dfd28403348e6644ab9257cbd7cfa91, type: 3}
    - Start: 8.797
      Duration: 6.494
      Text: "\uC624\uB298\uC740 \uC791\uC740 \uC12C \uB124 \uACF3\uC5D0\uC11C \uCC44\uC9D1
        \uBC29\uC2DD\uC774 \uB2EC\uB77C\uC9C0\uB294 \uACFC\uC815\uC744 \uBCF4\uC5EC\uB4DC\uB9B4\uAC8C\uC694."
      Narration: {fileID: 8300000, guid: b20f7ce47b88f314ab3b7fa32071c7c8, type: 3}
    ShowCredits: 0

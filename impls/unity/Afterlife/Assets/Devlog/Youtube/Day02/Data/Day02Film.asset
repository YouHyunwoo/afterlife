    Cues:
    - Start: 0.55
      Duration: 6.524
      Text: "\uC791\uC5C5\uD560 \uC7A5\uC18C\uB97C \uC815\uD574 \uB450\uACE0 \uB2E4\uB978
        \uACF3\uC744 \uC0B4\uD3B4\uBCFC \uC218 \uC788\uC73C\uBA74 \uC5B4\uB5A8\uAE4C
        \uC2F6\uC5C8\uC2B5\uB2C8\uB2E4."
      Narration: {fileID: 8300000, guid: 5b77719a2a251f646b35c62a4ab7de29, type: 3}
    - Start: 7.274
      Duration: 3.002

    Heading: "\uD3B8\uD558\uAC8C \uCE90\uACE0, \uC131\uC7A5\uD558\uB294 \uC7AC\uBBF8"
    Cues:
    - Start: 0.55
      Duration: 6.684
      Text: "\uB098\uBB34\uB97C \uCE90\uB294 \uC870\uC791\uC740 \uD3B8\uD558\uAC8C,
        \uAC15\uD654\uD558\uB294 \uC7AC\uBBF8\uB294 \uD655\uC2E4\uD558\uAC8C \uB9CC\uB4E4\uACE0
        \uC2F6\uC5C8\uC2B5\uB2C8\uB2E4."
      Narration: {fileID: 8300000, guid: 2ceefd592aa68e1419dfb13deedfb567, type: 3}
    - Start: 7.434
      Duration: 6.123
      Text: "\uB0AE\uC5D0\uB294 \uB9C8\uC744\uC744 \uD0A4\uC6B0\uACE0, \uBC24\uC5D0\uB294
        \uC801\uC744 \uB9C9\uB294 \uAC8C\uC784\uC744 \uB9CC\uB4E4\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
      Narration: {fileID: 8300000, guid: 4477aa06982ab504f8d1b782c31bbefd, type: 3}
    ShowCredits: 0
    ShowVision: 0
    TransitionToNight: 0
    NightTransitionStart: 7

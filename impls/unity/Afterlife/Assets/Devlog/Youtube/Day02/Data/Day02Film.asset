    AllowInteraction: 1
    Heading: "1 \xB7 \uD074\uB9AD \uD55C \uBC88, \uCC44\uC9D1 \uD55C \uBC88"
    Cues:
    - Start: 0.55
      Duration: 6.08
      Text: "\uCC98\uC74C\uC5D0\uB294 \uB098\uBB34\uB97C \uD074\uB9AD\uD560 \uB54C\uB9C8\uB2E4
        \uD55C \uBC88\uC529 \uCC44\uC9D1\uD558\uB3C4\uB85D \uB9CC\uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
      Narration: {fileID: 8300000, guid: 85eda960a58031f4ba523c632ef564aa, type: 3}
    - Start: 6.83
      Duration: 6.338
      Text: "\uB9DE\uC740 \uBD80\uBD84\uC758 \uC0C9\uC73C\uB85C \uD30C\uD3B8\uC774
        \uD280\uACE0, \uB3C4\uAD6C\uC640 \uB098\uBB34\uB3C4 \uD568\uAED8 \uBC18\uC751\uD569\uB2C8\uB2E4."
      Narration: {fileID: 8300000, guid: ba8d8abfcc3d5b24da51674a7c749802, type: 3}
    ShowCredits: 0
    ShowVision: 0

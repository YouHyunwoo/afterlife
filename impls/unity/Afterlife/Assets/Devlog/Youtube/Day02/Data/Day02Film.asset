    Heading: "\uCEE4\uC11C\uB97C \uC62C\uB824\uB450\uBA74 \uC790\uB3D9 \uCC44\uC9D1"
    Cues:
    - Start: 0.55
      Duration: 6.321
      Text: "\uB098\uBB34 \uC704\uC5D0 \uCEE4\uC11C\uB97C \uB450\uBA74 \uBC18\uBCF5\uD574\uC11C
        \uC791\uC5C5\uD569\uB2C8\uB2E4. \uBC14\uC704\uB3C4 \uB9C8\uCC2C\uAC00\uC9C0\uC608\uC694."
      Narration: {fileID: 8300000, guid: 0f5a4dc06d827c14d9ff31002eee86c6, type: 3}
    - Start: 7.071
      Duration: 7.536
      Text: "\uD074\uB9AD\uC740 \uC904\uC5C8\uC9C0\uB9CC, \uCEE4\uC11C\uB97C \uB5BC\uBA74
        \uC791\uC5C5\uC774 \uBA48\uCDA5\uB2C8\uB2E4. \uACB0\uAD6D \uB9C8\uC6B0\uC2A4\uAC00
        \uD55C \uACF3\uC5D0 \uBB36\uC600\uC8E0."
      Narration: {fileID: 8300000, guid: a0aa4e0bd56488648b0f0a0b3e474fbc, type: 3}
    ShowCredits: 0
    ShowVision: 0

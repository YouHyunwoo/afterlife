    Cues:
    - Start: 0.55
      Duration: 6.715
      Text: "\uC774\uBC88\uC5D0\uB294 \uAC19\uC740 \uC791\uC5C5 \uAC04\uACA9\uC5D0\uC11C
        \uD55C \uBC88\uC5D0 \uC5BC\uB9C8\uB098 \uCC44\uC9D1\uD558\uB294\uC9C0 \uBE44\uAD50\uD574
        \uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
      Narration: {fileID: 8300000, guid: 34bb2ebb787d1584891d04fc13beb371, type: 3}
    - Start: 7.465
      Duration: 4.381
      Text: "\uBA3C\uC800 \uAC15\uD654 \uC804\uC5D0\uB294 \uD55C \uBC88\uC5D0 \uD558\uB098\uC529
        \uCC44\uC9D1\uD569\uB2C8\uB2E4."
      Narration: {fileID: 8300000, guid: 97ee408df5928814c83efb54fd00c3bb, type: 3}

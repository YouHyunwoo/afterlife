    Cues:
    - Start: 0.55
      Duration: 6.526
      Text: "\uCC98\uC74C\uC5D0\uB294 \uB098\uBB34\uB098 \uBC14\uC704\uB97C \uD074\uB9AD\uD560
        \uB54C\uB9C8\uB2E4 \uD55C \uBC88\uC529 \uCC44\uC9D1\uD558\uAC8C \uB9CC\uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
      Narration: {fileID: 8300000, guid: c0557aac0323ce242894ff697910d8de, type: 3}
    - Start: 7.276
      Duration: 5.708
      Text: "\uC9C1\uC811 \uB204\uB974\uB294 \uB9DB\uC740 \uC788\uC9C0\uB9CC, \uC790\uC6D0\uC744
        \uBAA8\uC73C\uB824\uBA74 \uACC4\uC18D \uD074\uB9AD\uD574\uC57C \uD588\uC8E0."
      Narration: {fileID: 8300000, guid: fe50abc45eafe644cbff70e25edc2786, type: 3}
    ShowCredits: 0

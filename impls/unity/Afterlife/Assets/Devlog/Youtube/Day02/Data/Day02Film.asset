    Cues:
    - Start: 0.55
      Duration: 5.175
      Text: "\uC9C0\uC18D\uC801\uC778 \uC790\uB3D9 \uC218\uC785\uC740 \uB18D\uC7A5\uC774
        \uB9E1\uB3C4\uB85D \uB9CC\uB4E4 \uACC4\uD68D\uC785\uB2C8\uB2E4."
      Narration: {fileID: 8300000, guid: cdc4f90243af78b4e8b66443f9c60415, type: 3}
    - Start: 5.925
      Duration: 6.149
      Text: "\uB2E4\uC74C\uC5D0\uB294 \uC774\uB807\uAC8C \uBAA8\uC740 \uACE8\uB4DC\uB85C
        \uAC74\uBB3C\uC744 \uC9D3\uACE0, \uB9C8\uC744\uC744 \uD0A4\uC6CC \uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
      Narration: {fileID: 8300000, guid: 28d0643afec3ee64088a6da2c0bf04a1, type: 3}

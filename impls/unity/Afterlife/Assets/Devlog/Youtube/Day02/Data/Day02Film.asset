    Heading: "3 \xB7 \uAC15\uD654 \uD6C4 \xB7 \uC791\uC5C5\uB2F9 3 \xB7 \uC608\uC2DC"
    Cues:
    - Start: 0.55
      Duration: 7.453
      Text: "\uAC15\uD654\uD558\uBA74 \uC791\uC5C5 \uD55C \uBC88\uC758 \uD6A8\uACFC\uAC00
        \uCEE4\uC9D1\uB2C8\uB2E4. \uC5EC\uAE30\uC11C\uB294 \uBE44\uAD50\uB97C \uC704\uD574
        \uC138 \uBC30\uB85C \uC124\uC815\uD588\uC2B5\uB2C8\uB2E4."
      Narration: {fileID: 8300000, guid: 0804d1b16778b9c4c81a768f9114e2b6, type: 3}
    - Start: 8.203
      Duration: 6.634
      Text: "\uB354 \uBE60\uB974\uAC8C \uD074\uB9AD\uD560 \uD544\uC694 \uC5C6\uC774,
        \uAC19\uC740 \uC2DC\uAC04\uC5D0 \uB354 \uB9CE\uC740 \uC790\uC6D0\uC744 \uC5BB\uC744
        \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      Narration: {fileID: 8300000, guid: 616c6ab3ec8c7494ea8f08571071cfb1, type: 3}
    ShowCredits: 0
    ShowVision: 0
    TransitionToNight: 0
    NightTransitionStart: 7

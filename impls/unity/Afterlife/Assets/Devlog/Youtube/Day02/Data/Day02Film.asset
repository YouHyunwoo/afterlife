    Heading: "\uCC44\uC9D1 \uC2DC\uC2A4\uD15C\uC744 \uB2E4\uB4EC\uB294 \uACFC\uC815"
    Cues:
    - Start: 0.75
      Duration: 7.469
      Text: "\uC774 \uAC8C\uC784\uC740 \uB0AE\uC5D0 \uC790\uC6D0\uC744 \uBAA8\uC544
        \uB9C8\uC744\uC744 \uD0A4\uC6B0\uACE0, \uBC24\uC5D0 \uBAB0\uB824\uC624\uB294
        \uC801\uC744 \uB9C9\uB294 \uAC8C\uC784\uC785\uB2C8\uB2E4."
      Narration: {fileID: 8300000, guid: 6d72da116d609754abdc54725451d772, type: 3}
    - Start: 8.419
      Duration: 5.763
      Text: "\uC774\uBC88\uC5D0\uB294 \uCC44\uC9D1 \uBC29\uC2DD\uC774 \uBC14\uB010
        \uACFC\uC815\uC744 \uC791\uC740 \uC12C\uC5D0\uC11C \uBCF4\uC5EC\uB4DC\uB9B4\uAC8C\uC694."

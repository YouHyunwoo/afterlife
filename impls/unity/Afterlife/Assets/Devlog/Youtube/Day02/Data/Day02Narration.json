  "shots": [
    {
      "id": "intro-v2",
      "title": "채집 시스템을 다듬는 과정",
      "minimumDuration": 16,
      "stage": 0,
      "interactive": false,
      "cues": [
        {
          "start": 0.75,
          "duration": 7.469,
          "text": "이 게임은 낮에 자원을 모아 마을을 키우고, 밤에 몰려오는 적을 막는 게임입니다.",
          "file": "intro-v2-01.wav",
          "audioSeconds": 7.119,
          "signature": "410feaf668167da5472e790f7457b31f201b4ea6d4caf363875c7a43a5eebf9e",
          "peak": 0.70697,
          "sha256": "631def78ea016ac522ac9f573862c9fba4d33e6f2108521dca706c691ee73f6c"
        },
        {
          "start": 8.419,
          "duration": 5.763,
          "text": "이번에는 채집 방식이 바뀐 과정을 작은 섬에서 보여드릴게요.",
          "file": "intro-v2-02.wav",
          "audioSeconds": 5.413,
          "signature": "1446dc36ec8cf66339de3ad765716e645c6f94687c1c06b3fac8072e04a7c70a",
          "peak": 0.70697,
          "sha256": "d0e392f07b49d51ee4eb2a98bae17468f22f025eec16cded163e459a2133e487"
        }
      ],
      "duration": 16,
      "start": 0
    },
    {
      "id": "click-v2",
      "title": "처음에는 · 클릭 한 번, 채집 한 번",
      "minimumDuration": 22,
      "stage": 0,
      "interactive": true,
      "cues": [
        {
          "start": 0.55,
          "duration": 6.526,
          "text": "처음에는 나무나 바위를 클릭할 때마다 한 번씩 채집하게 만들었습니다.",
          "file": "click-v2-01.wav",
          "audioSeconds": 6.176,
          "signature": "3f1024756c9a4e75dc280ac66d612d2ec7b253c65409643a93cd9aaf6699dc1d",
          "peak": 0.70697,
          "sha256": "3681072ff596b52fd4eb3858c6449b848e10d0fa8f0381d36ef7fcdefca995f0"
        },
        {
          "start": 7.276,
          "duration": 5.708,
          "text": "직접 누르는 맛은 있지만, 자원을 모으려면 계속 클릭해야 했죠.",
          "file": "click-v2-02.wav",
          "audioSeconds": 5.358,
          "signature": "fc1aea1559e94204db55706f3c2a3de3d8f4154efe8a0655debd3c8f73e4929d",
          "peak": 0.70697,
          "sha256": "5cedf96736276686558c9a31879dec35404a35a4ea8395694047200097e473cc"
        }
      ],
      "duration": 22,
      "start": 16
    },
    {
      "id": "hover-why-v2",
      "title": "반복 클릭을 줄이려면?",
      "minimumDuration": 10,
      "stage": 1,
      "interactive": false,
      "cues": [
        {
          "start": 0.55,
          "duration": 5.593,
          "text": "그래서 커서를 올려두기만 해도 자동으로 채집되도록 바꿨습니다.",
          "file": "hover-why-v2-01.wav",
          "audioSeconds": 5.243,
          "signature": "08d7f026076bd406e7b80200abf49c805f361e356d443ce892959863a49429a4",
          "peak": 0.70697,
          "sha256": "c14627a2ea1fac076ab68c762367fdcfd9be374f91db3b7a2dc56f9578b5433a"
        }
      ],
      "duration": 10,
      "start": 38
    },
    {
      "id": "hover-v2",
      "title": "커서를 올려두면 자동 채집",
      "minimumDuration": 22,
      "stage": 1,
      "interactive": true,
      "cues": [
        {
          "start": 0.55,
          "duration": 6.321,
          "text": "나무 위에 커서를 두면 반복해서 작업합니다. 바위도 마찬가지예요.",
          "file": "hover-v2-01.wav",
          "audioSeconds": 5.971,
          "signature": "55f4594c05436220f71b4a7125765a27fb3a198fcfad165d719ba7196615ad26",
          "peak": 0.70697,
          "sha256": "12f547b4cd1c9e9b9cf5b9b43914e8c953f08bdbf8b2ef4924b87d6e3e6573ba"
        },
        {
          "start": 7.071,
          "duration": 7.536,
          "text": "클릭은 줄었지만, 커서를 떼면 작업이 멈춥니다. 결국 마우스가 한 곳에 묶였죠.",
          "file": "hover-v2-02.wav",
          "audioSeconds": 7.186,
          "signature": "7fdb3b83277b4205c89e7b71de7f7dc406f5db09ca7a8736c2a69093e3bbdf1f",
          "peak": 0.70697,
          "sha256": "596ec71a9416dbd604eccbed3af3d875a7d6be29cd0d1fef9e5c7fe0176ba5a7"
        }
      ],
      "duration": 22,
      "start": 48
    },
    {
      "id": "field-why-v2",
      "title": "작업할 장소를 남겨두면?",
      "minimumDuration": 12,
      "stage": 2,
      "interactive": false,
      "cues": [
        {
          "start": 0.55,
          "duration": 6.524,
          "text": "작업할 장소를 정해 두고 다른 곳을 살펴볼 수 있으면 어떨까 싶었습니다.",
          "file": "field-why-v2-01.wav",
          "audioSeconds": 6.174,
          "signature": "e0a240d8c5ec6c8f2e51066f38875fd83016ee6045c51476fa1b03bee1137acc",
          "peak": 0.70697,
          "sha256": "0b52fde6f10f0c5c8f3cc8a41a8f032f13a54cf469d4fa2db39437e3690f1f64"
        },
        {
          "start": 7.274,
          "duration": 3.002,
          "text": "그래서 영력 필드를 만들었어요.",
          "file": "field-why-v2-02.wav",
          "audioSeconds": 2.652,
          "signature": "66744048c2530158dd0ee634bd075e2e6eec616a54ddebd103756a9d227eb60f",
          "peak": 0.70697,
          "sha256": "ce94776c8405506095c1509beb38c9215cdbeb3dd98e99b8a456ccee059b4ba7"
        }
      ],
      "duration": 12,
      "start": 70
    },
    {

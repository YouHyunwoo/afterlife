      "title": "작은 범위에 영력 필드 설치",
      "minimumDuration": 24,
      "stage": 2,
      "interactive": true,
      "cues": [
        {
          "start": 0.55,
          "duration": 4.455,
          "text": "나무와 바위 사이에 작은 필드를 놓아보겠습니다.",
          "file": "field-v2-01.wav",
          "audioSeconds": 4.105,
          "signature": "47a74bebf44ab6e58667b15986e2c129142e66f97ab79d55bcf80093563b8fa2",
          "peak": 0.70697,
          "sha256": "58124764b5bd11fe3d8ec454fdcd9a3f3dd060566cf5142cda879c627831ab8f"
        },
        {
          "start": 5.205,
          "duration": 7.208,
          "text": "커서를 옮겨도 범위 안에서는 작업이 이어집니다. 어디에 놓느냐가 중요해졌죠.",
          "file": "field-v2-02.wav",
          "audioSeconds": 6.858,
          "signature": "88d7d3483cc09566d0e67dd876c441373032510ba4cc2fe79fbf50804243d522",
          "peak": 0.70697,
          "sha256": "29dae4f0b605b91a02dcb103ee662ab39de43ef43d52aabe6637c6049e1b5e2e"
        }
      ],
      "duration": 24,
      "start": 82
    },

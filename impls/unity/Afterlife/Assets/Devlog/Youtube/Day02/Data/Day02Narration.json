      "minimumDuration": 10,
      "stage": 3,
      "interactive": false,
      "cues": [
        {
          "start": 0.55,
          "duration": 4.586,
          "text": "이제 조금 더 큰 섬에서 자유롭게 채집해 볼게요.",
          "file": "island-v2-01.wav",
          "audioSeconds": 4.236,

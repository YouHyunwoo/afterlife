--- !u!114 &8367639661518884476
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 686928622408569633}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5660f8689d4762540b508d8abe422fc6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Subtitle: {fileID: 5698176969388456158}
  Voice: {fileID: 4741434847896364630}
  Lines:
  - "\uB208\uC744 \uB5B4\uAD6C\uB098. \uB450\uB824\uC6CC \uB9D0\uAC70\uB77C.\n\uB124
    \uBAB8\uC740 \uC544\uC9C1 \uC800\uD3B8\uC5D0\uC11C \uC7A0\uB4E4\uC5B4 \uC788\uB2E4."
  - "\uB098\uB294 \uC2E0\uC758 \uB73B\uC744 \uC804\uD558\uB294 \uC790.\n\uB108\uB294
    \uD0DC\uC5B4\uB098\uB358 \uB0A0, \uC601\uC6C5\uC758 \uC2DC\uD5D8\uC744 \uCE58\uB97C
    \uD6C4\uBCF4\uB85C \uBF51\uD614\uB2E4."
  - "\uC800 \uD2C8 \uB108\uBA38\uB294 \uB124\uAC00 \uC0B4\uB358 \uC138\uACC4\uB2E4.\n\uC800
    \uB9C8\uC744\uC740 \uBC24\uB9C8\uB2E4 \uB9C8\uBB3C\uC758 \uC2B5\uACA9\uC744 \uBC1B\uACE0
    \uC788\uC9C0."
  - "\uB124\uAC8C \uC7A0\uC2DC \uC601\uB825\uC744 \uBE4C\uB824\uC8FC\uACA0\uB2E4.\n\uB9C8\uC744\uC744
    \uC77C\uC73C\uD0A4\uACE0, \uB2E4\uAC00\uC62C \uBC24\uB4E4\uC744 \uACAC\uB514\uAC8C
    \uD558\uAC70\uB77C."
  - "\uC2DC\uD5D8\uC744 \uB9C8\uCE58\uBA74, \uB3CC\uC544\uAC08 \uAE38\uC774 \uC5F4\uB9B4
    \uAC83\uC774\uB2E4."
  VoiceClips: []
  ProgressRoot: {fileID: 7239152062544347796}
